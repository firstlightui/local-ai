{
    "name": "firstlightui/local-ai",
    "description": "On-device text generation for NativePHP Mobile using the operating system's built-in models: Apple Foundation Models on iOS and Gemini Nano (ML Kit GenAI) on Android.",
    "type": "nativephp-plugin",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "nativephp/mobile": "^4.6"
    },
    "require-dev": {
        "pestphp/pest": "^3.0|^4.0",
        "illuminate/console": "^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "FirstlightUI\\LocalAI\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "FirstlightUI\\LocalAI\\LocalAIServiceProvider"
            ],
            "aliases": {
                "LocalAI": "FirstlightUI\\LocalAI\\Facades\\LocalAI"
            }
        },
        "nativephp": {
            "manifest": "nativephp.json"
        }
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
