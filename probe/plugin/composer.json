{
  "name": "firstlightui/local-llm-feasibility",
  "description": "Milestone 1 feasibility probe; not the published Firstlight Local LLM API",
  "type": "nativephp-plugin",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "FirstlightUI\\LocalLLM\\Probe\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "FirstlightUI\\LocalLLM\\Probe\\ProbeServiceProvider"
      ]
    },
    "nativephp": {
      "manifest": "nativephp.json"
    }
  },
  "require": {
    "php": "^8.3",
    "nativephp/mobile": "4.5.1"
  }
}
