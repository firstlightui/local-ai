{
  "namespace": "LocalLLMFeasibility",
  "platforms": ["ios", "android"],
  "bridge_functions": [
    {
      "name": "LocalLLMProbe.Start",
      "ios": "LocalLLMProbeFunctions.Start",
      "android": "dev.firstlightui.plugins.local_llm.probe.LocalLLMProbeFunctions.Start",
      "android_params": ["context"]
    },
    {
      "name": "LocalLLMProbe.Cancel",
      "ios": "LocalLLMProbeFunctions.Cancel",
      "android": "dev.firstlightui.plugins.local_llm.probe.LocalLLMProbeFunctions.Cancel",
      "android_params": ["context"]
    },
    {
      "name": "LocalLLMProbe.Unload",
      "ios": "LocalLLMProbeFunctions.Unload",
      "android": "dev.firstlightui.plugins.local_llm.probe.LocalLLMProbeFunctions.Unload",
      "android_params": ["context"]
    },
    {
      "name": "LocalLLMProbe.SetBackgrounded",
      "ios": "LocalLLMProbeFunctions.SetBackgrounded",
      "android": "dev.firstlightui.plugins.local_llm.probe.LocalLLMProbeFunctions.SetBackgrounded",
      "android_params": ["context"]
    }
  ],
  "events": [
    "FirstlightUI\\LocalLLM\\Probe\\Events\\ProbeDelta",
    "FirstlightUI\\LocalLLM\\Probe\\Events\\ProbeTerminal"
  ],
  "ios": {
    "min_version": "18.0",
    "init_function": "initializeLocalLLMProbe",
    "sources": ["LocalLLMProbeFunctions.swift", "LocalLLMProbeLifecycle.swift", "LocalLLMProbeRuntime.swift"],
    "dependencies": {
      "swift_packages": [
        {
          "url": "https://github.com/ml-explore/mlx-swift-lm",
          "version": "3.31.4",
          "products": ["MLXLLM", "MLXLMCommon", "MLXHuggingFace"]
        },
        {
          "url": "https://github.com/huggingface/swift-transformers",
          "version": "1.3.4",
          "products": ["Tokenizers"]
        },
        {
          "url": "https://github.com/ml-explore/mlx-swift",
          "version": "0.31.6",
          "products": ["MLX"]
        }
      ]
    }
  },
  "android": {
    "init_function": "dev.firstlightui.plugins.local_llm.probe.initializeLocalLLMProbe",
    "min_version": 29,
    "dependencies": {
      "implementation": [
        "dev.firstlightui.plugins.local_llm:llama-android-probe:0.1.0"
      ]
    },
    "repositories": [
      {
        "url": "$rootDir/local-llm-maven"
      }
    ]
  }
}
